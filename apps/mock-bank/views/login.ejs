<html>
<head><title>CU Core &mdash; Sign On</title></head>
<body bgcolor="#d6d3ce">
<table width="100%" cellpadding="4" cellspacing="0" border="0">
  <tr bgcolor="#003366">
    <td><font color="#ffffff" face="Arial" size="4"><b>Member Services Terminal</b></font></td>
  </tr>
</table>
<table cellpadding="8" cellspacing="0" border="1">
  <tr>
    <td>
      <% if (typeof reason !== "undefined" && reason === "timeout") { %>
        <table bgcolor="#fff3b0" width="100%"><tr><td>
          <font color="#7a5b00"><b>Your session has expired. Please sign on again.</b></font>
        </td></tr></table>
        <br/>
      <% } %>
      <form method="POST" action="/login">
        <table cellpadding="4" cellspacing="0" border="0">
          <tr>
            <td><label for="username">Operator ID</label></td>
            <td><input type="text" id="username" name="username" /></td>
          </tr>
          <tr>
            <td><label for="password">Password</label></td>
            <td><input type="password" id="password" name="password" /></td>
          </tr>
          <tr>
            <td colspan="2" align="right"><input type="submit" value="Sign On" /></td>
          </tr>
        </table>
      </form>
    </td>
  </tr>
</table>
</body>
</html>
