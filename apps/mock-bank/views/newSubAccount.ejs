<html>
<head><title><%= labels.brandName %> &mdash; Open Sub-Account</title></head>
<body bgcolor="#d6d3ce">
<table width="100%" cellpadding="4" cellspacing="0" border="0">
  <tr bgcolor="#003366">
    <td><font color="#ffffff" face="Arial" size="4"><b>Member Services Terminal</b></font></td>
    <td align="right"><font color="#ffffff" face="Arial" size="2">Signed on as <%= username %> &nbsp; | &nbsp; <a href="/logout"><font color="#ffffff">Sign Off</font></a></font></td>
  </tr>
</table>
<% if (labels.bannerText) { %>
  <table width="100%" cellpadding="6" cellspacing="0" border="0">
    <tr bgcolor="#e8edf5"><td><font face="Arial" size="2"><i><%= labels.bannerText %></i></font></td></tr>
  </table>
<% } %>
<br/>
<table cellpadding="2" cellspacing="0" border="0">
  <tr><td><a href="/members/<%= memberId %>">&laquo; Back to Member</a></td></tr>
</table>
<br/>
<table cellpadding="8" cellspacing="0" border="1">
  <tr>
    <td>
      <font face="Arial" size="3"><b>Open New Sub-Account for Member <%= memberId %></b></font>
      <br/><br/>
      <% if (typeof error !== "undefined" && error) { %>
        <table bgcolor="#f8d0d0" width="100%"><tr><td>
          <font color="#7a0000"><b><%= error %></b></font>
        </td></tr></table>
        <br/>
      <% } %>
      <form method="POST" action="/members/<%= memberId %>/sub-accounts">
        <table cellpadding="4" cellspacing="0" border="0">
          <tr>
            <td><label for="accountType"><%= labels.accountTypeLabel %></label></td>
            <td>
              <select id="accountType" name="accountType">
                <option value="Savings" <%= (typeof accountType !== 'undefined' && accountType === 'Savings') ? 'selected' : '' %>>Savings</option>
                <option value="Checking" <%= (typeof accountType !== 'undefined' && accountType === 'Checking') ? 'selected' : '' %>>Checking</option>
                <option value="CD" <%= (typeof accountType !== 'undefined' && accountType === 'CD') ? 'selected' : '' %>>Certificate of Deposit</option>
              </select>
            </td>
          </tr>
          <tr>
            <td><label for="initialDeposit"><%= labels.initialDepositLabel %></label></td>
            <td><input type="text" id="initialDeposit" name="initialDeposit" value="<%= typeof initialDeposit !== 'undefined' ? initialDeposit : '' %>" /></td>
          </tr>
          <tr>
            <td colspan="2" align="right"><input type="submit" value="<%= labels.submitLabel %>" /></td>
          </tr>
        </table>
      </form>
    </td>
  </tr>
</table>
</body>
</html>
