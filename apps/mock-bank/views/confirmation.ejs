<html>
<head><title>CU Core &mdash; Confirmation</title></head>
<body bgcolor="#d6d3ce">
<table width="100%" cellpadding="4" cellspacing="0" border="0">
  <tr bgcolor="#003366">
    <td><font color="#ffffff" face="Arial" size="4"><b>Member Services Terminal</b></font></td>
    <td align="right"><font color="#ffffff" face="Arial" size="2">Signed on as <%= username %> &nbsp; | &nbsp; <a href="/logout"><font color="#ffffff">Sign Off</font></a></font></td>
  </tr>
</table>
<br/>
<table bgcolor="#d6f5d6" cellpadding="8" cellspacing="0" border="1">
  <tr><td>
    <font color="#0a5d0a" size="3"><b><span id="confirmationBanner">Sub-account opened successfully.</span></b></font>
  </td></tr>
</table>
<br/>
<table cellpadding="8" cellspacing="0" border="1">
  <tr>
    <td>
      <table cellpadding="3" cellspacing="0" border="0">
        <tr><td><b>Confirmation Number</b></td><td><span id="confirmationNumberValue"><%= subAccount.id %></span></td></tr>
        <tr><td><b>Member ID</b></td><td><%= subAccount.memberId %></td></tr>
        <tr><td><b>Account Type</b></td><td><span id="accountTypeValue"><%= subAccount.accountType %></span></td></tr>
        <tr><td><b>Initial Deposit</b></td><td><span id="initialDepositValue">$<%= subAccount.initialDeposit.toFixed(2) %></span></td></tr>
      </table>
    </td>
  </tr>
</table>
<br/>
<a href="/members/<%= subAccount.memberId %>">&laquo; Back to Member</a>
</body>
</html>
