<html>
<head><title><%= labels.brandName %> &mdash; Member Detail</title></head>
<body bgcolor="#d6d3ce">
<table width="100%" cellpadding="4" cellspacing="0" border="0">
  <tr bgcolor="#003366">
    <td><font color="#ffffff" face="Arial" size="4"><b>Member Services Terminal</b></font></td>
    <td align="right"><font color="#ffffff" face="Arial" size="2">Signed on as <%= username %> &nbsp; | &nbsp; <a href="/logout"><font color="#ffffff">Sign Off</font></a></font></td>
  </tr>
</table>
<% if (labels.bannerText) { %>
  <table width="100%" cellpadding="6" cellspacing="0" border="0">
    <tr bgcolor="#e8edf5"><td><font face="Arial" size="2"><i><%= labels.bannerText %></i></font></td></tr>
  </table>
<% } %>
<br/>
<table cellpadding="2" cellspacing="0" border="0">
  <tr><td><a href="/search">&laquo; Back to Search</a></td></tr>
</table>
<br/>

<% if (accessDenied) { %>
  <table bgcolor="#f8d0d0" cellpadding="8" border="1">
    <tr><td><font color="#7a0000"><b><%= labels.accessDeniedText %></b> Operator <%= username %> is not permitted to view member <%= member.id %>.</font></td></tr>
  </table>
<% } else { %>
  <table cellpadding="8" cellspacing="0" border="1">
    <tr>
      <td>
        <table cellpadding="3" cellspacing="0" border="0">
          <tr><td><b>Member ID</b></td><td><span id="memberIdValue"><%= member.id %></span></td></tr>
          <tr><td><b>Name</b></td><td><span id="memberNameValue"><%= member.name %></span></td></tr>
          <tr><td><b>Checking Balance</b></td><td><span id="checkingBalanceValue">$<%= member.checkingBalance.toFixed(2) %></span></td></tr>
          <tr><td><b>Savings Balance</b></td><td><span id="savingsBalanceValue">$<%= member.savingsBalance.toFixed(2) %></span></td></tr>
        </table>
      </td>
    </tr>
  </table>
  <br/>
  <table cellpadding="4" cellspacing="0" border="1" width="100%">
    <tr bgcolor="#003366"><td colspan="3"><font color="#ffffff"><b>Sub-Accounts</b></font></td></tr>
    <% if (subAccounts.length === 0) { %>
      <tr><td colspan="3"><i>No sub-accounts on file.</i></td></tr>
    <% } else { %>
      <% subAccounts.forEach(function(sa) { %>
        <tr><td><%= sa.id %></td><td><%= sa.accountType %></td><td>$<%= sa.initialDeposit.toFixed(2) %></td></tr>
      <% }); %>
    <% } %>
  </table>
  <br/>
  <% if (labels.bannerText) { %>
    <div><a href="/members/<%= member.id %>/sub-accounts/new"><%= labels.openNewSubAccountLabel %></a></div>
  <% } else { %>
    <a href="/members/<%= member.id %>/sub-accounts/new"><%= labels.openNewSubAccountLabel %></a>
  <% } %>
<% } %>
</body>
</html>
