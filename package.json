    "dashboard": "tsx src/dashboard/server.ts",
    "capability-api": "tsx src/api/server.ts",
    "agent-invoke-demo": "tsx src/cli/agent-invoke-demo.ts",
    "agent-chat": "tsx src/cli/agent-chat.ts",
