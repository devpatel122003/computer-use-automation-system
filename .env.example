# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Required for anything that calls Gemini: discovery (npm run run-agent), the conversational
# front end (npm run agent-chat), and assisted/vision-grounded recovery (--assisted-recovery,
# npm run vision-fallback-demo). Get a key at https://ai.google.dev.
GEMINI_API_KEY=your-gemini-key-here

# Optional -- defaults to gemini-3.7-flash if unset. See README.md "Setup" for why you may
# need to switch this if you hit a free-tier daily quota (RESOURCE_EXHAUSTED).
GEMINI_MODEL=gemini-3.7-flash

# Optional, comma-separated, tried in order after GEMINI_MODEL. Every real Gemini call in
# this repo (discovery, the conversational front end, assisted/vision recovery) now falls
# back to the next model in this list the moment it detects GEMINI_MODEL's daily quota is
# exhausted (not a per-minute rate limit -- those still just back off and retry the same
# model). Leave unset to keep today's single-model behavior. See README.md "Setup".
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash

# Required to start the capability API (npm run capability-api) and to call it from a CLI
# (npm run agent-invoke-demo, npm run agent-chat) or the chat UI (npm run chat-ui). Generate
# one locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Sent by callers as `Authorization: Bearer <value>` (or `X-API-Key: <value>`). See
# SECURITY.md for the threat model this protects against.
#
# As of the per-operator identity feature, this env var (and DASHBOARD_PASSWORD below) is
# consumed indirectly, via config/operators.json's "local-operator" entry -- a solo dev's
# setup needs no changes at all. See "Multi-operator setup" below to add a second, named
# human operator without touching any code.
CAPABILITY_API_KEY=generate-a-random-value-do-not-reuse-this-placeholder

# Required to start the dashboard (npm run dashboard). This is the *password* half of HTTP
# Basic auth for the "local-operator" entry in config/operators.json, whose username is
# "operator" -- the browser will prompt for that username and this password the first time
# you open http://localhost:4600. Generate one locally the same way as above.
DASHBOARD_PASSWORD=generate-a-random-value-do-not-reuse-this-placeholder

# Multi-operator setup: add entries to config/operators.json (id + apiKeyEnvVar and/or
# dashboardUsername + dashboardPasswordEnvVar), then set the referenced env var(s) here.
# Example, for a second operator named "alice":
# OPERATOR_ALICE_API_KEY=generate-a-random-value-do-not-reuse-this-placeholder

# Optional port overrides -- defaults shown. Only needed if the default is already in use.
# CAPABILITY_API_PORT=4700
# DASHBOARD_PORT=4600
# PORT=4000            # mock-bank
# CHAT_UI_PORT=4800

# Optional -- where the chat UI (npm run chat-ui) sends invoke calls. Only needed if the
# capability API isn't on its default port/host.
# CAPABILITY_API_BASE=http://localhost:4700

# Optional -- defaults to headed (a real, visible Chromium window) so invoking a capability
# through an agent or the chat UI is actually watchable, the same way `run-agent`/`replay`
# already are -- not a black box that just returns JSON. Set to "false" for a genuinely
# unattended, high-throughput caller with no one watching (a scheduled canary check, a load
# test) -- docker-compose.yml already sets this to "false" for the containerized capability
# API, since a container has no display to render a window on regardless of this setting.
# CAPABILITY_API_HEADED=true

# Optional -- the chat UI's own service-account operator credential, injected server-side
# into every capability call it makes (see docs/15-conversational-frontend.md). A real
# customer chatting with it never states, or needs to know, this credential. Defaults to
# the same demo_operator/demo_password used everywhere else in this repo's demo if unset.
# CHAT_UI_OPERATOR_USERNAME=demo_operator
# CHAT_UI_OPERATOR_PASSWORD=demo_password

# Optional -- a DIFFERENT, unrelated credential from the two lines just above: this is the
# chat UI's own capability-API key, attributed to the fixed internal identity
# "chat-ui-service" in config/operators.json rather than any human operator or customer, so
# every chat-UI-originated run's evidence/audit trail says who actually triggered it. Falls
# back to CAPABILITY_API_KEY (resolving to "local-operator") if unset, so local/dev setups
# need nothing extra.
# CHAT_UI_SERVICE_API_KEY=generate-a-random-value-do-not-reuse-this-placeholder
